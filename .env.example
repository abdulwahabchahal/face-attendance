# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
APP_VERSION=2.0.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./attendance.db

# ── Recognition ───────────────────────────────────────────────────────────────
RECOGNITION_THRESHOLD=0.65      # cosine similarity cutoff (lower = stricter)
CONFIRM_FRAMES=3                # consecutive detections before marking
ANTI_SPAM_MINUTES=5             # ignore same employee within N minutes

# ── Shift Defaults ────────────────────────────────────────────────────────────
DEFAULT_SHIFT_START=09:00
DEFAULT_SHIFT_END=17:00
LATE_GRACE_MINUTES=10           # minutes grace after shift start
HALF_DAY_HOUR=11                # check-in at/after this hour = Half Day

# ── Paths ─────────────────────────────────────────────────────────────────────
UNKNOWN_FACES_DIR=unknown_faces

# ── ML Model ──────────────────────────────────────────────────────────────────
MODEL_NAME=vggface2
CAMERA_INDEX=0                  # 0=default webcam, 1=external camera
